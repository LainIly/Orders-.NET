@page "/countries"

<h3>Paises</h3>

<div class="mb-3">
    <a class="btn btn-primary" href="/countries/create">Agregar Pais</a>
</div>

<GenericList MyList="Countries"> @*Componenete generico que se le debe pasar la lista de paises*@
    <Body> @*Body obligatorio para el componente generico*@
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Pais</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var country in Countries!)
                {
                    <tr>
                        <td>@country.Name</td>
                        <td>
                            <a class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>